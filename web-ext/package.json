{
  "name": "web-ext",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun scripts/build.ts --watch",
    "dev:firefox": "bun scripts/build.ts --watch --firefox",
    "build": "bun scripts/build.ts --production",
    "build:firefox": "bun scripts/build.ts --production --firefox",
    "release": "bun run build && bun scripts/release.ts",
    "release:firefox": "bun run build:firefox && bun scripts/release.ts --firefox",
    "type-check": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "bun test",
    "check": "bun run type-check && bun test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dom-chef": "^5.1.1",
    "element-ready": "^7.0.0",
    "immer": "^10.1.1",
    "preact": "^10.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.8.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.2.24",
    "autoprefixer": "^10.4.19",
    "chrome-types": "^0.1.231",
    "happy-dom": "^20.14.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5"
  }
}
