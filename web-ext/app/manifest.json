{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "action": {
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "Toppings",
    "default_popup": "popup/index.html"
  },
  "author": "Enrych",
  "background": {
    "service_worker": "/background.js"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "/content.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ],
      "run_at": "document_end"
    }
  ],
  "description": "Your YouTube, your way.",
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "manifest_version": 3,
  "name": "Toppings on YouTube",
  "options_ui": {
    "open_in_tab": true,
    "page": "/options/index.html"
  },
  "permissions": [
    "alarms",
    "offscreen",
    "scripting",
    "storage"
  ],
  "short_name": "Toppings",
  "web_accessible_resources": [
    {
      "matches": [
        "https://*/*"
      ],
      "resources": [
        "assets/*"
      ]
    }
  ]
}
